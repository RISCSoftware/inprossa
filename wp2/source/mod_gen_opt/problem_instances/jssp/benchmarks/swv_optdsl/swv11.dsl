# Job Shop Scheduling instance: swv11
# Minimize makespan (total completion time for all jobs).

N_JOBS : int = 50
N_MACHINES : int = 10
MAX_TIME : int = 25399

# PROCESSING_TIMES[j][op] and MACHINE_SEQUENCE[j][op] define each job route.
PROCESSING_TIMES : DSList(N_JOBS, DSList(N_MACHINES, DSInt())) = [[92, 47, 56, 91, 49, 39, 63, 12, 1, 37], [86, 100, 75, 92, 90, 11, 85, 54, 100, 38], [4, 94, 44, 40, 92, 53, 40, 5, 68, 27], [87, 48, 59, 92, 35, 99, 46, 27, 83, 91], [83, 78, 76, 64, 44, 12, 91, 31, 98, 63], [49, 15, 100, 18, 24, 92, 65, 26, 29, 24], [28, 53, 84, 47, 85, 100, 34, 35, 90, 88], [61, 71, 54, 34, 13, 47, 2, 97, 27, 97], [85, 75, 33, 72, 49, 23, 12, 90, 87, 42], [24, 20, 65, 33, 75, 47, 84, 44, 74, 29], [48, 27, 1, 23, 66, 35, 46, 29, 63, 44], [79, 4, 61, 46, 69, 10, 88, 19, 50, 34], [16, 31, 77, 3, 25, 88, 97, 49, 79, 22], [40, 39, 15, 93, 48, 63, 74, 46, 91, 51], [48, 93, 8, 50, 5, 48, 46, 35, 88, 97], [70, 8, 65, 32, 84, 9, 43, 10, 72, 60], [21, 28, 26, 91, 58, 90, 43, 64, 39, 93], [50, 60, 51, 90, 93, 20, 33, 27, 12, 89], [21, 3, 47, 34, 53, 67, 8, 68, 1, 71], [57, 26, 36, 48, 11, 44, 25, 30, 92, 57], [20, 20, 6, 74, 48, 77, 15, 80, 27, 10], [71, 40, 86, 23, 29, 99, 56, 100, 77, 28], [83, 61, 27, 86, 99, 31, 60, 40, 84, 26], [68, 94, 46, 60, 33, 46, 86, 63, 70, 89], [33, 13, 91, 27, 38, 82, 31, 23, 27, 87], [58, 30, 24, 12, 38, 2, 37, 59, 37, 36], [62, 47, 5, 39, 75, 60, 65, 61, 77, 31], [100, 21, 53, 74, 3, 34, 6, 91, 80, 28], [8, 3, 88, 54, 18, 4, 34, 54, 59, 42], [33, 72, 83, 17, 23, 24, 60, 96, 78, 70], [63, 36, 70, 97, 99, 71, 92, 41, 73, 97], [28, 37, 24, 30, 55, 38, 9, 77, 17, 51], [15, 46, 14, 18, 99, 48, 41, 10, 47, 80], [89, 78, 51, 63, 29, 70, 7, 14, 84, 32], [26, 69, 92, 15, 23, 42, 95, 47, 83, 56], [38, 44, 47, 23, 10, 63, 65, 21, 70, 56], [42, 85, 29, 35, 66, 46, 25, 90, 85, 75], [99, 46, 74, 96, 48, 52, 13, 88, 4, 30], [15, 80, 47, 25, 8, 61, 70, 23, 93, 5], [90, 51, 66, 5, 86, 59, 97, 28, 85, 9], [59, 50, 40, 23, 93, 61, 96, 63, 34, 14], [62, 72, 30, 21, 15, 77, 13, 2, 22, 22], [20, 14, 85, 4, 2, 33, 90, 48, 90, 62], [49, 49, 46, 89, 64, 72, 6, 83, 13, 66], [74, 55, 73, 25, 16, 19, 38, 22, 26, 63], [13, 96, 8, 15, 97, 95, 2, 66, 57, 46], [73, 97, 39, 22, 90, 64, 65, 31, 98, 85], [43, 67, 38, 77, 11, 61, 7, 95, 97, 69], [35, 68, 5, 46, 4, 51, 44, 58, 69, 98], [68, 81, 2, 4, 59, 53, 69, 69, 14, 21]]
MACHINE_SEQUENCE : DSList(N_JOBS, DSList(N_MACHINES, DSInt())) = [[0, 4, 3, 2, 1, 5, 9, 7, 6, 8], [0, 2, 1, 3, 4, 5, 7, 8, 9, 6], [1, 4, 3, 2, 0, 8, 6, 9, 5, 7], [4, 0, 1, 2, 3, 6, 7, 9, 8, 5], [0, 1, 4, 3, 2, 8, 9, 6, 7, 5], [3, 0, 1, 4, 2, 6, 9, 5, 7, 8], [0, 3, 4, 2, 1, 7, 5, 6, 8, 9], [2, 4, 3, 1, 0, 9, 8, 6, 7, 5], [0, 2, 1, 4, 3, 7, 5, 8, 6, 9], [2, 3, 1, 4, 0, 9, 6, 8, 7, 5], [2, 3, 4, 0, 1, 6, 7, 9, 5, 8], [2, 0, 4, 3, 1, 7, 8, 9, 6, 5], [0, 4, 3, 2, 1, 8, 7, 9, 6, 5], [1, 0, 4, 2, 3, 6, 9, 8, 7, 5], [4, 0, 2, 3, 1, 6, 7, 9, 5, 8], [3, 1, 2, 0, 4, 8, 6, 7, 5, 9], [0, 2, 1, 3, 4, 9, 6, 8, 5, 7], [1, 2, 0, 4, 3, 7, 9, 8, 6, 5], [1, 3, 2, 4, 0, 9, 8, 5, 7, 6], [3, 4, 2, 0, 1, 9, 7, 5, 8, 6], [1, 0, 4, 3, 2, 9, 8, 5, 7, 6], [3, 1, 0, 2, 4, 7, 8, 6, 9, 5], [4, 0, 3, 1, 2, 7, 5, 8, 9, 6], [4, 1, 3, 2, 0, 7, 5, 9, 6, 8], [4, 1, 2, 3, 0, 8, 7, 6, 9, 5], [4, 3, 0, 2, 1, 8, 9, 5, 6, 7], [2, 1, 4, 3, 0, 7, 9, 8, 6, 5], [4, 0, 1, 3, 2, 8, 6, 7, 9, 5], [1, 0, 2, 3, 4, 9, 6, 5, 8, 7], [3, 4, 0, 2, 1, 6, 8, 9, 7, 5], [4, 2, 3, 0, 1, 6, 9, 5, 8, 7], [2, 1, 4, 0, 3, 8, 5, 9, 7, 6], [3, 0, 2, 4, 1, 9, 6, 5, 7, 8], [4, 3, 2, 1, 0, 7, 9, 5, 8, 6], [4, 1, 2, 3, 0, 8, 6, 5, 9, 7], [1, 2, 3, 4, 0, 9, 7, 6, 5, 8], [3, 4, 1, 0, 2, 9, 8, 5, 7, 6], [3, 0, 4, 2, 1, 5, 6, 7, 8, 9], [1, 3, 4, 2, 0, 9, 7, 8, 6, 5], [0, 2, 3, 4, 1, 5, 6, 9, 7, 8], [0, 1, 4, 3, 2, 7, 9, 8, 6, 5], [1, 2, 4, 0, 3, 5, 6, 7, 8, 9], [2, 4, 3, 1, 0, 9, 7, 5, 8, 6], [0, 3, 4, 1, 2, 9, 8, 5, 6, 7], [4, 1, 2, 0, 3, 7, 9, 6, 5, 8], [3, 2, 1, 0, 4, 6, 7, 5, 8, 9], [4, 1, 3, 0, 2, 9, 6, 8, 5, 7], [3, 2, 0, 1, 4, 7, 5, 9, 8, 6], [0, 2, 1, 3, 4, 7, 6, 5, 9, 8], [2, 1, 0, 3, 4, 9, 8, 5, 6, 7]]

# Decision variable: completion time of operation op for each job.
completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))


def precedence_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # Each job's operations must respect sequence order with processing times.
    for j in range(N_JOBS):
        first_machine = MACHINE_SEQUENCE[j][0]
        assert completion[j][0] >= PROCESSING_TIMES[j][first_machine]
        for op in range(1, N_MACHINES):
            machine = MACHINE_SEQUENCE[j][op]
            assert completion[j][op] >= completion[j][op - 1] + PROCESSING_TIMES[j][machine]


def no_overlap_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # No two jobs can use the same machine at overlapping times.
    for m in range(N_MACHINES):
        for j1 in range(N_JOBS):
            for op1 in range(N_MACHINES):
                if MACHINE_SEQUENCE[j1][op1] == m:
                    for j2 in range(j1 + 1, N_JOBS):
                        for op2 in range(N_MACHINES):
                            if MACHINE_SEQUENCE[j2][op2] == m:
                                assert (
                                    completion[j1][op1] >= completion[j2][op2] + PROCESSING_TIMES[j1][m]
                                    or completion[j2][op2] >= completion[j1][op1] + PROCESSING_TIMES[j2][m]
                                )


def makespan(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    ms: DSInt() = 0
    for j in range(N_JOBS):
        if completion[j][N_MACHINES - 1] > ms:
            ms = completion[j][N_MACHINES - 1]
    return ms


precedence_constraint(completion)
no_overlap_constraint(completion)

objective: DSInt(0, MAX_TIME) = makespan(completion)

minimize(objective)
