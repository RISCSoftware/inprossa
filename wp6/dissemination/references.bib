@techreport{Boegl2026TechReport,
  author      = {Michael B{\"o}gl},
  title       = {{Unifying Search Paradigms using optDSL}},
  year        = {2026},
  month       = {October},
  date        = {2026-10-28},
  type        = {Technical Report},
  institution = {RISC Software GmbH},
  address     = {Hagenberg, Austria},
  abstract    = {In practical combinatorial optimization, solver-paradigm
                 decisions are frequently made at an early project stage. Such
                 early commitments constrain subsequent modeling choices and can
                 render later paradigm changes technically and organizationally
                 costly. This report addresses that limitation through a
                 workflow that enables paradigm switching over the full project
                 lifecycle. The workflow is based on optDSL as a shared problem
                 representation, leveraging its existing MiniZinc translation and
                 extending the same representation with a Large Neighborhood
                 Search (LNS) backend.},
  keywords    = {combinatorial optimization, domain-specific languages,
                 large neighborhood search, MiniZinc, optDSL},
  sponsor     = {Supported by the FFG project FO999923579 ``InProSSA: Industrial
                 Problem Solving Using Symbolic and Subsymbolic AI''}
}

