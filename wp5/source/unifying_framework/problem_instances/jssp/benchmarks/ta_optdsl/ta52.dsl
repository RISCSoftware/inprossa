MACHINE_SEQUENCE : DSList(N_JOBS, DSList(N_MACHINES, DSInt())) = [[1, 12, 2, 6, 10, 0, 11, 9, 4, 7, 5, 13, 14, 3, 8], [7, 1, 0, 11, 4, 9, 10, 2, 5, 6, 13, 12, 8, 3, 14], [9, 3, 5, 10, 8, 6, 12, 4, 7, 0, 13, 14, 11, 2, 1], [10, 7, 3, 12, 8, 0, 5, 6, 11, 1, 14, 9, 2, 4, 13], [11, 0, 9, 3, 7, 13, 8, 6, 5, 1, 2, 12, 14, 10, 4], [2, 4, 14, 7, 1, 8, 0, 6, 5, 10, 13, 3, 9, 12, 11], [4, 3, 7, 10, 9, 8, 2, 13, 14, 11, 1, 6, 5, 0, 12], [13, 14, 2, 12, 5, 8, 10, 4, 0, 3, 7, 11, 1, 9, 6], [14, 6, 1, 3, 0, 7, 4, 9, 10, 8, 12, 2, 11, 13, 5], [4, 3, 7, 6, 0, 8, 10, 1, 11, 12, 13, 9, 5, 14, 2], [1, 3, 14, 8, 2, 5, 9, 6, 12, 0, 7, 10, 11, 4, 13], [12, 2, 4, 6, 11, 9, 3, 7, 8, 5, 10, 14, 1, 13, 0], [6, 14, 2, 11, 0, 3, 12, 5, 1, 8, 13, 9, 7, 10, 4], [5, 11, 4, 0, 9, 10, 14, 12, 3, 7, 1, 8, 2, 13, 6], [8, 3, 14, 12, 9, 10, 4, 5, 13, 7, 2, 11, 1, 6, 0], [11, 4, 13, 0, 14, 5, 9, 10, 12, 6, 3, 2, 8, 1, 7], [14, 0, 5, 4, 10, 1, 8, 9, 12, 11, 3, 13, 7, 6, 2], [14, 13, 1, 9, 8, 12, 6, 10, 0, 11, 7, 4, 3, 2, 5], [10, 0, 12, 4, 7, 1, 6, 5, 3, 2, 9, 8, 11, 13, 14], [2, 8, 10, 0, 11, 14, 6, 1, 4, 7, 13, 12, 5, 3, 9], [3, 14, 11, 7, 0, 9, 12, 13, 4, 8, 1, 10, 5, 6, 2], [9, 8, 7, 1, 0, 3, 6, 14, 2, 4, 5, 10, 13, 11, 12], [10, 14, 6, 9, 13, 5, 7, 0, 12, 11, 8, 2, 3, 1, 4], [12, 2, 0, 5, 13, 9, 6, 14, 1, 8, 3, 7, 4, 10, 11], [4, 1, 14, 7, 6, 2, 10, 0, 11, 5, 13, 3, 8, 12, 9], [0, 14, 11, 4, 6, 1, 10, 8, 3, 13, 9, 12, 7, 2, 5], [4, 3, 0, 10, 6, 9, 5, 14, 7, 1, 12, 2, 11, 13, 8], [7, 9, 2, 4, 14, 10, 8, 1, 3, 13, 11, 0, 5, 12, 6], [6, 10, 11, 14, 9, 0, 1, 2, 7, 8, 5, 3, 12, 4, 13], [8, 12, 14, 7, 11, 0, 10, 13, 2, 6, 3, 9, 5, 4, 1], [9, 5, 12, 7, 14, 1, 0, 6, 3, 4, 2, 8, 13, 10, 11], [4, 5, 10, 1, 0, 2, 8, 9, 14, 12, 6, 13, 11, 3, 7], [9, 7, 0, 10, 13, 14, 8, 12, 1, 2, 4, 6, 11, 3, 5], [1, 8, 0, 12, 5, 11, 2, 4, 7, 14, 9, 6, 10, 3, 13], [14, 8, 5, 9, 6, 0, 13, 3, 2, 12, 7, 4, 1, 11, 10], [5, 12, 8, 14, 0, 1, 10, 3, 9, 4, 7, 2, 13, 6, 11], [4, 0, 11, 14, 5, 1, 6, 7, 9, 12, 8, 3, 10, 2, 13], [7, 2, 10,