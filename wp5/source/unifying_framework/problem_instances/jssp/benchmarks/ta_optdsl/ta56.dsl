MACHINE_SEQUENCE : DSList(N_JOBS, DSList(N_MACHINES, DSInt())) = [[7, 8, 0, 14, 11, 6, 5, 9, 13, 1, 2, 12, 4, 10, 3], [14, 0, 6, 10, 1, 11, 2, 9, 8, 3, 4, 5, 12, 7, 13], [10, 6, 3, 11, 0, 5, 4, 1, 13, 2, 12, 14, 9, 7, 8], [11, 14, 3, 0, 12, 9, 10, 7, 5, 6, 2, 8, 4, 13, 1], [5, 7, 0, 3, 10, 1, 9, 11, 8, 12, 13, 14, 2, 6, 4], [6, 13, 1, 7, 10, 0, 11, 8, 9, 5, 12, 14, 4, 3, 2], [14, 8, 3, 9, 5, 0, 1, 6, 2, 7, 12, 10, 4, 13, 11], [8, 13, 0, 3, 10, 1, 2, 14, 11, 7, 5, 6, 12, 9, 4], [6, 10, 1, 11, 5, 4, 12, 9, 2, 8, 13, 14, 7, 0, 3], [4, 9, 6, 10, 8, 1, 7, 14, 13, 5, 2, 11, 12, 0, 3], [4, 1, 3, 7, 13, 5, 8, 10, 12, 0, 6, 14, 11, 2, 9], [9, 7, 10, 2, 6, 12, 8, 13, 14, 5, 1, 0, 3, 11, 4], [3, 2, 12, 4, 11, 7, 5, 1, 14, 10, 8, 9, 13, 6, 0], [13, 14, 1, 3, 2, 11, 9, 8, 6, 0, 12, 10, 7, 5, 4], [10, 3, 2, 11, 5, 9, 0, 12, 8, 13, 4, 7, 14, 1, 6], [2, 13, 14, 11, 1, 5, 3, 4, 8, 12, 10, 0, 6, 9, 7], [6, 11, 3, 10, 4, 2, 0, 14, 7, 13, 1, 12, 9, 8, 5], [6, 8, 10, 14, 1, 5, 3, 0, 9, 4, 12, 11, 13, 7, 2], [10, 1, 2, 5, 7, 12, 13, 11, 0, 9, 3, 8, 4, 14, 6], [12, 4, 11, 13, 9, 8, 7, 10, 0, 2, 3, 6, 5, 14, 1], [11, 6, 0, 12, 14, 7, 10, 5, 2, 4, 8, 13, 3, 9, 1], [14, 7, 9, 1, 4, 13, 5, 0, 2, 12, 10, 11, 6, 8, 3], [9, 5, 1, 14, 2, 3, 0, 11, 12, 10, 4, 8, 7, 13, 6], [9, 10, 3, 8, 0, 5, 6, 4, 12, 2, 14, 1, 7, 13, 11], [14, 8, 9, 5, 11, 0, 12, 13, 4, 7, 10, 1, 6, 3, 2], [6, 10, 7, 13, 12, 3, 2, 11, 5, 4, 1, 0, 8, 14, 9], [10, 11, 9, 13, 3, 7, 6, 12, 0, 14, 1, 4, 8, 5, 2], [5, 7, 3, 14, 13, 10, 8, 9, 1, 12, 2, 0, 4, 11, 6], [9, 10, 4, 14, 8, 6, 1, 2, 11, 12, 13, 0, 3, 7, 5], [10, 1, 4, 2, 3, 12, 5, 0, 9, 14, 8, 7, 6, 13, 11], [3, 9, 11, 5, 4, 2, 14, 0, 12, 1, 10, 13, 8, 7, 6], [6, 2, 12, 13, 4, 0, 10, 1, 5, 9, 14, 7, 8, 11, 3], [0, 14, 11, 5, 6, 7, 1, 3, 4, 9, 13, 10, 8, 2, 12], [13, 6, 4, 11, 9, 5, 2, 12, 14, 10, 0, 3, 7, 8, 1], [0, 1, 13, 2, 4, 7, 12, 3, 10, 8, 11, 6, 9, 5, 14], [7, 2, 4, 3, 6, 9, 11, 13, 10, 8, 1, 14, 5, 12, 0], [1, 12, 2, 5, 0, 7, 13, 10, 14, 4, 11, 6, 9, 8, 3], [14, 4, 9,