MACHINE_SEQUENCE : DSList(N_JOBS, DSList(N_MACHINES, DSInt())) = [[3, 17, 14, 10, 5, 12, 18, 8, 15, 4, 1, 7, 9, 6, 16, 0, 13, 2, 11, 19], [8, 7, 12, 14, 1, 4, 17, 19, 9, 15, 0, 3, 2, 6, 11, 16, 10, 5, 18, 13], [18, 14, 1, 11, 0, 6, 12, 4, 15, 5, 13, 17, 9, 16, 8, 2, 19, 3, 7, 10], [15, 1, 4, 11, 3, 2, 17, 10, 14, 13, 16, 7, 18, 0, 12, 5, 8, 9, 6, 19], [5, 10, 15, 13, 16, 19, 18, 2, 4, 7, 8, 17, 11, 9, 14, 6, 3, 0, 12, 1], [9, 16, 1, 5, 6, 11, 13, 14, 2, 0, 4, 17, 15, 19, 10, 18, 8, 3, 7, 12], [2, 6, 7, 14, 4, 12, 15, 16, 13, 5, 1, 10, 0, 17, 9, 18, 3, 19, 8, 11], [8, 14, 13, 16, 10, 7, 2, 19, 0, 6, 5, 12, 4, 11, 1, 3, 18, 17, 9, 15], [3, 0, 14, 4, 15, 6, 8, 5, 17, 9, 13, 16, 1, 2, 12, 10, 18, 19, 7, 11], [1, 19, 0, 7, 2, 6, 10, 4, 17, 5, 12, 13, 14, 15, 18, 16, 3, 8, 9, 11], [9, 0, 1, 13, 3, 16, 14, 2, 5, 12, 7, 8, 19, 4, 18, 10, 11, 6, 15, 17], [1, 14, 4, 11, 2, 7, 3, 12, 16, 9, 13, 17, 18, 0, 10, 15, 5, 8, 6, 19], [0, 9, 10, 4, 2, 3, 7, 12, 11, 17, 14, 15, 13, 6, 8, 19, 18, 1, 16, 5], [17, 11, 5, 3, 14, 7, 1, 15, 10, 12, 13, 16, 2, 18, 19, 0, 9, 8, 4, 6], [3, 19, 4, 10, 2, 1, 11, 15, 0, 5, 14, 17, 8, 13, 12, 6, 7, 9, 18, 16], [9, 0, 6, 14, 3, 11, 8, 10, 2, 13, 15, 19, 4, 18, 17, 12, 1, 5, 7, 16], [17, 12, 18, 6, 14, 16, 13, 2, 9, 19, 7, 3, 8, 11, 0, 4, 1, 5, 15, 10], [3, 15, 0, 2, 4, 6, 9, 10, 14, 16, 11, 5, 17, 13, 18, 19, 8, 1, 12, 7], [0, 6, 17, 4, 1, 2, 18, 12, 11, 16, 10, 15, 3, 13, 8, 14, 19, 7, 9, 5], [6, 19, 3, 13, 18, 4, 7, 1, 9, 16, 8, 17, 10, 14, 2, 15, 11, 12, 5, 0], [8, 18, 7, 14, 0, 11, 4, 9, 13, 5, 3, 12, 17, 16, 2, 15, 19, 6, 10, 1], [15, 0, 8, 9, 13, 5, 3, 16, 10, 17, 1, 7, 14, 4, 18, 2, 12, 6, 19, 11], [14, 17, 19, 5, 16, 6, 4, 10, 15, 18, 12, 13, 8, 2, 7, 9, 1, 0, 11, 3], [19, 13, 2, 17, 9, 1, 4, 0, 3, 11, 10, 8, 18, 14, 16, 12, 15, 7, 5, 6], [6, 14, 15, 7, 4, 16, 11, 0, 1, 10, 17, 19, 13, 18, 3, 12, 8, 5, 2, 9], [8, 6, 4, 7, 15, 10, 18, 3, 13, 19, 14, 5, 0, 2, 11, 16, 17, 12, 9, 1], [4, 0, 5, 8, 9, 18, 14, 15, 10, 12, 13, 7, 11, 3, 16, 2, 6, 1, 19, 17], [18, 7, 3, 9, 14, 6, 0, 15, 8, 19, 11, 12, 13, 5, 10, 4, 1, 16, 2, 17], [3, 15, 11, 9, 16, 5, 12, 19, 13, 0, 17, 2, 8, 1, 6, 14, 18, 4, 7, 10], [7, 18, 16, 10, 4, 3, 11, 0, 17, 14, 2, 5, 9, 6, 19, 15, 13, 12, 8, 1]]

# Decision variable: completion time of operation op for each job.
completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))


def precedence_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # Each job's operations must respect sequence order with processing times.
    for j in range(N_JOBS):
        assert completion[j][0] >= PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][0]]
        for op in range(1, N_MACHINES):
            assert completion[j][op] >= completion[j][op - 1] + PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][op]]


def no_overlap_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # No two jobs can use the same machine at overlapping times.
    for m in range(N_MACHINES):
        for j1 in range(N_JOBS):
            for op1 in range(N_MACHINES):
                if MACHINE_SEQUENCE[j1][op1] == m:
                    for j2 in range(j1 + 1, N_JOBS):
                        for op2 in range(N_MACHINES):
                            if MACHINE_SEQUENCE[j2][op2] == m:
                                assert (
                                    completion[j1][op1] >= completion[j2][op2] + PROCESSING_TIMES[j1][m]
                                    or completion[j2][op2] >= completion[j1][op1] + PROCESSING_TIMES[j2][m]
                                )


def makespan(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    ms: DSInt() = 0
    for j in range(N_JOBS):
        if completion[j][N_MACHINES - 1] > ms:
            ms = completion[j][N_MACHINES - 1]
    return ms


precedence_constraint(completion)
no_overlap_constraint(completion)

objective: DSInt(0, MAX_TIME) = makespan(completion)

minimize(objective)
