4, 21, 69, 11, 43, 42, 27, 87, 19, 97, 58, 47, 11, 7, 67, 81, 46, 53, 39], [13, 24, 4, 23, 25, 39, 27, 29, 39, 19, 77, 44, 37, 44, 31, 38, 13, 44, 38, 95], [90, 39, 37, 87, 39, 72, 86, 90, 33, 88, 73, 91, 43, 56, 36, 2, 37, 19, 34, 66], [6, 20, 32, 5, 16, 40, 48, 21, 21, 93, 56, 67, 56, 24, 57, 97, 75, 15, 37, 9], [51, 29, 58, 24, 3, 82, 97, 85, 40, 37, 45, 88, 29, 38, 30, 31, 51, 45, 37, 30], [38, 97, 21, 26, 89, 96, 48, 34, 23, 33, 18, 46, 38, 50, 35, 69, 70, 57, 77, 8]]
MACHINE_SEQUENCE : DSList(N_JOBS, DSList(N_MACHINES, DSInt())) = [[5, 0, 6, 16, 2, 15, 19, 10, 12, 13, 4, 3, 9, 17, 18, 1, 7, 8, 14, 11], [17, 11, 16, 13, 1, 7, 4, 14, 10, 8, 2, 19, 3, 12, 6, 5, 0, 15, 9, 18], [15, 9, 18, 19, 1, 16, 17, 8, 0, 14, 13, 2, 7, 3, 12, 11, 5, 6, 10, 4], [13, 1, 19, 2, 10, 6, 8, 3, 0, 16, 9, 5, 14, 17, 15, 11, 12, 4, 18, 7], [13, 3, 2, 19, 1, 0, 15, 6, 18, 14, 5, 16, 17, 9, 11, 10, 12, 7, 4, 8], [6, 17, 14, 19, 7, 12, 3, 18, 5, 11, 8, 0, 1, 15, 16, 10, 13, 4, 2, 9], [0, 10, 15, 11, 17, 14, 5, 6, 8, 3, 9, 16, 12, 2, 1, 19, 18, 13, 7, 4], [9, 10, 8, 13, 16, 18, 15, 3, 6, 5, 1, 11, 14, 0, 7, 17, 2, 12, 4, 19], [4, 6, 19, 5, 2, 9, 16, 18, 7, 8, 12, 1, 15, 13, 17, 10, 0, 14, 3, 11], [17, 1, 12, 5, 2, 3, 8, 7, 6, 9, 19, 15, 14, 10, 4, 18, 11, 16, 13, 0], [17, 15, 11, 0, 7, 6, 5, 9, 4, 12, 10, 2, 14, 16, 19, 3, 13, 8, 1, 18], [13, 14, 2, 5, 0, 11, 16, 17, 15, 9, 18, 6, 19, 7, 12, 3, 4, 1, 10, 8], [3, 5, 13, 0, 14, 12, 11, 16, 2, 19, 8, 9, 15, 4, 7, 17, 6, 18, 10, 1], [15, 5, 18, 17, 6, 16, 13, 12, 3, 2, 9, 0, 1, 14, 8, 10, 11, 19, 4, 7], [10, 6, 19, 15, 4, 17, 8, 1, 12, 18, 0, 9, 3, 5, 13, 11, 2, 16, 7, 14], [3, 9, 16, 6, 7, 11, 14, 8, 18, 12, 5, 17, 19, 10, 2, 1, 0, 15, 13, 4], [13, 18, 5, 6, 8, 0, 4, 10, 7, 12, 1, 15, 3, 16, 19, 2, 11, 17, 9, 14], [5, 15, 1, 2, 19, 18, 12, 13, 16, 17, 14, 9, 0, 11, 10, 3, 8, 4, 6, 7], [8, 14, 6, 3, 11, 4, 12, 15, 1, 0, 17, 7, 5, 10, 19, 2, 18, 13, 16, 9], [10, 0, 14, 2, 16, 19, 17, 6, 3, 8, 12, 11, 7, 13, 15, 9, 1, 5, 4, 18], [17, 14, 1, 4, 7, 16, 0, 18, 19, 13, 15, 8, 2, 11, 10, 6, 3, 12, 9, 5], [14, 16, 17, 5, 4, 8, 10, 12, 3, 19, 2, 9, 18, 13, 15, 0, 7, 1, 6, 11], [1, 14, 2, 8, 13, 6, 12, 3, 5, 18, 17, 11, 10, 0, 7, 19, 15, 4, 16, 9], [7, 11, 3, 9, 8, 4, 18, 5, 14, 0, 10, 13, 1, 2, 15, 17, 19, 6, 12, 16], [19, 6, 9, 16, 17, 8, 14, 11, 7, 10, 18, 2, 3, 0, 1, 12, 4, 5, 15, 13], [2, 16, 17, 6, 3, 4, 11, 5, 18, 14, 15, 19, 0, 9, 7, 12, 13, 10, 1, 8], [13, 11, 16, 14, 6, 15, 1, 17, 0, 12, 5, 3, 2, 4, 7, 8, 10, 9, 18, 19], [10, 2, 6, 0, 19, 14, 7, 12, 18, 16, 5, 9, 15, 3, 11, 13, 1, 17, 4, 8], [15, 19, 11, 17, 18, 13, 4, 6, 8, 12, 3, 14, 1, 10, 16, 2, 5, 0, 7, 9], [0, 18, 19, 6, 11, 4, 5, 13, 2, 12, 17, 3, 1, 16, 8, 10, 9, 7, 14, 15]]

# Decision variable: completion time of operation op for each job.
completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))


def precedence_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # Each job's operations must respect sequence order with processing times.
    for j in range(N_JOBS):
        assert completion[j][0] >= PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][0]]
        for op in range(1, N_MACHINES):
            assert completion[j][op] >= completion[j][op - 1] + PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][op]]


def no_overlap_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # No two jobs can use the same machine at overlapping times.
    for m in range(N_MACHINES):
        for j1 in range(N_JOBS):
            for op1 in range(N_MACHINES):
                if MACHINE_SEQUENCE[j1][op1] == m:
                    for j2 in range(j1 + 1, N_JOBS):
                        for op2 in range(N_MACHINES):
                            if MACHINE_SEQUENCE[j2][op2] == m:
                                assert (
                                    completion[j1][op1] >= completion[j2][op2] + PROCESSING_TIMES[j1][m]
                                    or completion[j2][op2] >= completion[j1][op1] + PROCESSING_TIMES[j2][m]
                                )


def makespan(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    ms: DSInt() = 0
    for j in range(N_JOBS):
        if completion[j][N_MACHINES - 1] > ms:
            ms = completion[j][N_MACHINES - 1]
    return ms


precedence_constraint(completion)
no_overlap_constraint(completion)

objective: DSInt(0, MAX_TIME) = makespan(completion)

minimize(objective)
