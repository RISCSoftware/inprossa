7, 75, 79, 38, 98, 73, 88, 59, 52, 85, 4, 37, 57, 44, 63, 74, 68, 48], [80, 40, 74, 7, 49, 82, 91, 90, 26, 56, 38, 88, 93, 32, 74, 35, 59, 40, 44, 60], [93, 99, 73, 41, 25, 12, 53, 98, 86, 57, 4, 77, 1, 14, 75, 60, 5, 54, 13, 13], [33, 42, 84, 48, 76, 64, 14, 87, 97, 31, 62, 67, 84, 45, 71, 62, 51, 49, 75, 30], [31, 17, 76, 49, 39, 66, 40, 44, 51, 11, 64, 98, 43, 21, 96, 19, 54, 30, 74, 9], [91, 33, 71, 77, 48, 49, 27, 39, 74, 92, 91, 36, 91, 62, 17, 47, 31, 58, 82, 28]]
MACHINE_SEQUENCE : DSList(N_JOBS, DSList(N_MACHINES, DSInt())) = [[5, 13, 3, 15, 19, 9, 10, 6, 12, 4, 2, 14, 8, 7, 16, 11, 0, 17, 18, 1], [13, 2, 15, 12, 4, 9, 3, 7, 5, 0, 8, 14, 6, 19, 1, 10, 18, 17, 16, 11], [8, 5, 2, 18, 17, 14, 0, 4, 11, 3, 16, 7, 6, 1, 12, 15, 10, 19, 13, 9], [13, 8, 0, 11, 3, 14, 7, 4, 18, 6, 19, 5, 2, 9, 10, 15, 17, 1, 12, 16], [8, 6, 2, 13, 16, 11, 15, 12, 9, 4, 19, 17, 5, 3, 7, 1, 10, 18, 14, 0], [1, 13, 10, 0, 2, 12, 19, 5, 17, 16, 18, 4, 15, 8, 7, 6, 14, 11, 3, 9], [2, 3, 16, 17, 10, 15, 13, 12, 9, 19, 8, 0, 18, 11, 14, 1, 5, 7, 4, 6], [12, 10, 17, 4, 3, 11, 2, 19, 8, 9, 13, 14, 7, 18, 15, 6, 16, 1, 5, 0], [10, 14, 3, 0, 7, 17, 19, 2, 11, 16, 6, 4, 18, 1, 13, 5, 12, 15, 8, 9], [0, 2, 3, 9, 8, 12, 16, 13, 4, 10, 6, 19, 15, 1, 5, 17, 7, 14, 18, 11], [1, 4, 0, 10, 15, 11, 16, 9, 19, 13, 14, 8, 6, 17, 18, 12, 2, 7, 3, 5], [6, 5, 9, 10, 0, 2, 3, 12, 11, 7, 13, 8, 19, 14, 16, 4, 17, 1, 18, 15], [13, 19, 11, 5, 2, 15, 14, 4, 3, 6, 10, 1, 12, 18, 9, 7, 16, 17, 8, 0], [10, 3, 4, 9, 17, 8, 0, 19, 2, 11, 12, 1, 18, 15, 5, 16, 6, 14, 13, 7], [4, 14, 8, 15, 11, 9, 10, 1, 17, 16, 5, 18, 6, 13, 19, 12, 7, 3, 2, 0], [4, 9, 18, 19, 3, 17, 15, 16, 5, 8, 11, 14, 0, 2, 1, 12, 6, 10, 13, 7], [17, 10, 13, 19, 0, 12, 14, 18, 2, 5, 11, 16, 7, 4, 8, 1, 15, 6, 9, 3], [19, 13, 9, 3, 6, 17, 7, 16, 5, 14, 15, 18, 0, 2, 1, 12, 8, 11, 10, 4], [9, 11, 17, 13, 3, 1, 10, 16, 0, 5, 7, 6, 4, 2, 18, 15, 14, 19, 8, 12], [17, 8, 13, 7, 4, 0, 6, 9, 16, 18, 11, 5, 10, 12, 2, 19, 15, 14, 3, 1], [17, 2, 7, 16, 6, 12, 14, 9, 3, 18, 0, 4, 5, 8, 1, 19, 10, 11, 15, 13], [0, 7, 16, 12, 3, 6, 19, 2, 10, 9, 18, 8, 13, 5, 11, 4, 15, 1, 17, 14], [10, 18, 4, 5, 12, 6, 9, 1, 11, 13, 8, 7, 17, 0, 2, 14, 19, 15, 16, 3], [14, 0, 5, 11, 9, 19, 10, 15, 2, 3, 4, 18, 17, 13, 12, 7, 6, 1, 16, 8], [11, 6, 18, 14, 16, 0, 17, 10, 9, 2, 7, 4, 19, 5, 8, 1, 12, 15, 13, 3], [18, 13, 10, 12, 1, 9, 0, 7, 2, 5, 16, 6, 17, 8, 14, 3, 4, 11, 19, 15], [14, 2, 19, 10, 11, 16, 9, 7, 15, 1, 5, 13, 4, 8, 18, 0, 3, 12, 6, 17], [0, 18, 8, 9, 12, 17, 16, 19, 15, 11, 2, 13, 3, 10, 5, 7, 6, 4, 1, 14], [18, 11, 9, 14, 4, 0, 16, 3, 8, 6, 13, 15, 7, 2, 10, 12, 19, 17, 5, 1], [16, 3, 9, 6, 2, 18, 11, 1, 4, 0, 5, 7, 12, 15, 8, 14, 13, 19, 10, 17]]

# Decision variable: completion time of operation op for each job.
completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))


def precedence_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # Each job's operations must respect sequence order with processing times.
    for j in range(N_JOBS):
        assert completion[j][0] >= PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][0]]
        for op in range(1, N_MACHINES):
            assert completion[j][op] >= completion[j][op - 1] + PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][op]]


def no_overlap_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # No two jobs can use the same machine at overlapping times.
    for m in range(N_MACHINES):
        for j1 in range(N_JOBS):
            for op1 in range(N_MACHINES):
                if MACHINE_SEQUENCE[j1][op1] == m:
                    for j2 in range(j1 + 1, N_JOBS):
                        for op2 in range(N_MACHINES):
                            if MACHINE_SEQUENCE[j2][op2] == m:
                                assert (
                                    completion[j1][op1] >= completion[j2][op2] + PROCESSING_TIMES[j1][m]
                                    or completion[j2][op2] >= completion[j1][op1] + PROCESSING_TIMES[j2][m]
                                )


def makespan(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    ms: DSInt() = 0
    for j in range(N_JOBS):
        if completion[j][N_MACHINES - 1] > ms:
            ms = completion[j][N_MACHINES - 1]
    return ms


precedence_constraint(completion)
no_overlap_constraint(completion)

objective: DSInt(0, MAX_TIME) = makespan(completion)

minimize(objective)
