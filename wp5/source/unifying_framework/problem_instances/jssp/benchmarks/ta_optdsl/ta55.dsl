MACHINE_SEQUENCE : DSList(N_JOBS, DSList(N_MACHINES, DSInt())) = [[5, 0, 2, 14, 12, 4, 7, 13, 1, 10, 11, 6, 9, 3, 8], [7, 2, 1, 8, 12, 9, 3, 11, 13, 14, 0, 6, 4, 10, 5], [4, 6, 5, 13, 0, 7, 14, 11, 9, 10, 12, 3, 8, 1, 2], [9, 13, 3, 11, 14, 12, 6, 1, 0, 4, 10, 5, 2, 7, 8], [11, 8, 1, 9, 2, 5, 6, 12, 7, 13, 3, 10, 0, 14, 4], [9, 3, 4, 7, 11, 2, 13, 5, 8, 12, 6, 10, 14, 0, 1], [1, 2, 3, 5, 13, 10, 6, 0, 8, 4, 12, 11, 7, 9, 14], [1, 14, 10, 12, 4, 8, 7, 13, 6, 2, 9, 3, 5, 11, 0], [6, 13, 2, 4, 12, 14, 3, 5, 10, 9, 11, 0, 1, 7, 8], [11, 13, 0, 10, 6, 9, 1, 2, 14, 3, 5, 8, 7, 4, 12], [9, 10, 5, 12, 7, 0, 14, 6, 1, 2, 11, 4, 8, 13, 3], [12, 5, 1, 13, 2, 8, 6, 4, 7, 10, 0, 3, 14, 11, 9], [4, 1, 8, 10, 5, 12, 6, 13, 7, 3, 9, 0, 14, 2, 11], [13, 12, 2, 5, 11, 7, 9, 14, 6, 0, 8, 10, 1, 3, 4], [11, 7, 14, 2, 12, 6, 4, 0, 9, 10, 1, 13, 5, 3, 8], [14, 5, 9, 11, 3, 0, 12, 1, 4, 6, 10, 8, 7, 13, 2], [0, 9, 2, 5, 13, 4, 1, 14, 6, 3, 10, 12, 8, 7, 11], [11, 6, 0, 5, 10, 12, 2, 14, 13, 1, 7, 8, 9, 3, 4], [7, 10, 4, 0, 12, 14, 11, 9, 5, 3, 2, 13, 1, 8, 6], [4, 9, 12, 10, 14, 3, 7, 11, 2, 0, 8, 1, 6, 13, 5], [3, 10, 14, 5, 6, 7, 1, 2, 4, 13, 12, 9, 8, 11, 0], [10, 12, 13, 2, 1, 0, 5, 6, 11, 8, 9, 3, 7, 14, 4], [5, 2, 0, 13, 1, 6, 4, 9, 8, 11, 10, 3, 14, 7, 12], [11, 4, 6, 10, 12, 8, 2, 7, 9, 14, 1, 0, 13, 3, 5], [11, 14, 9, 13, 2, 0, 4, 1, 8, 10, 12, 6, 5, 7, 3], [14, 0, 8, 1, 11, 12, 13, 2, 9, 4, 7, 6, 3, 10, 5], [3, 1, 12, 11, 4, 7, 6, 10, 9, 2, 13, 5, 14, 8, 0], [12, 14, 10, 0, 5, 13, 1, 11, 4, 3, 6, 8, 2, 9, 7], [4, 10, 13, 6, 0, 11, 7, 9, 14, 12, 8, 1, 3, 2, 5], [3, 5, 2, 9, 13, 11, 12, 6, 10, 4, 8, 0, 14, 1, 7], [1, 6, 7, 5, 11, 3, 12, 9, 2, 10, 13, 4, 14, 0, 8], [5, 4, 10, 9, 0, 6, 3, 1, 7, 13, 12, 11, 14, 8, 2], [11, 13, 6, 5, 1, 8, 14, 0, 3, 12, 4, 9, 7, 10, 2], [11, 9, 2, 1, 12, 0, 8, 13, 10, 5, 14, 6, 4, 7, 3], [12, 8, 6, 4, 14, 13, 0, 9, 1, 3, 7, 5, 10, 11, 2], [0, 4, 12, 6, 14, 10, 5, 7, 3, 13, 1, 2, 9, 8, 11], [6, 11, 13, 5, 2, 12, 0, 4, 1, 10, 8, 3, 7, 9, 14], [5, 6, 11,