MACHINE_SEQUENCE : DSList(N_JOBS, DSList(N_MACHINES, DSInt())) = [[6, 5, 15, 8, 13, 2, 10, 17, 11, 0, 9, 1, 19, 4, 16, 3, 12, 7, 18, 14], [2, 13, 11, 4, 18, 12, 16, 17, 19, 14, 5, 3, 1, 7, 9, 6, 15, 0, 8, 10], [18, 16, 14, 13, 0, 7, 1, 19, 3, 12, 15, 6, 5, 2, 8, 9, 4, 10, 17, 11], [9, 10, 5, 14, 18, 2, 8, 11, 12, 3, 4, 1, 6, 19, 13, 7, 0, 16, 15, 17], [8, 3, 7, 9, 5, 1, 17, 4, 14, 15, 13, 12, 16, 10, 11, 0, 19, 6, 2, 18], [6, 8, 9, 2, 13, 14, 1, 3, 15, 19, 4, 0, 18, 10, 12, 17, 5, 16, 11, 7], [16, 7, 12, 2, 13, 6, 5, 8, 3, 18, 9, 15, 17, 11, 14, 0, 19, 10, 1, 4], [9, 5, 2, 8, 10, 13, 4, 1, 11, 17, 19, 3, 14, 16, 0, 7, 15, 18, 12, 6], [16, 4, 15, 1, 11, 8, 3, 6, 9, 17, 0, 18, 10, 2, 12, 13, 19, 5, 14, 7], [3, 14, 15, 17, 8, 10, 6, 19, 0, 18, 9, 1, 16, 5, 4, 13, 11, 12, 7, 2], [2, 15, 4, 16, 7, 8, 1, 6, 18, 19, 10, 14, 5, 3, 17, 13, 0, 11, 12, 9], [13, 11, 5, 9, 17, 6, 7, 16, 0, 8, 15, 10, 18, 1, 2, 19, 4, 3, 14, 12], [16, 7, 13, 12, 2, 19, 10, 14, 15, 17, 5, 1, 4, 11, 0, 18, 3, 9, 6, 8], [2, 0, 19, 8, 18, 10, 17, 3, 13, 6, 14, 16, 12, 7, 4, 1, 11, 15, 5, 9], [5, 1, 14, 9, 8, 3, 11, 10, 0, 7, 13, 12, 2, 16, 19, 17, 4, 15, 18, 6], [17, 16, 4, 0, 15, 5, 3, 14, 12, 2, 10, 18, 8, 6, 1, 19, 11, 13, 9, 7], [10, 4, 3, 1, 17, 0, 5, 8, 7, 12, 19, 13, 15, 9, 14, 2, 16, 11, 6, 18], [3, 16, 15, 5, 13, 11, 19, 12, 8, 6, 18, 7, 17, 10, 0, 1, 14, 2, 4, 9], [14, 0, 11, 5, 4, 12, 18, 8, 10, 13, 16, 7, 6, 1, 3, 9, 15, 17, 2, 19], [7, 4, 11, 2, 15, 14, 5, 19, 16, 1, 9, 13, 3, 8, 10, 12, 0, 6, 17, 18], [8, 6, 10, 15, 5, 3, 18, 1, 17, 9, 19, 4, 16, 13, 0, 7, 11, 14, 2, 12], [10, 17, 6, 8, 7, 19, 2, 0, 3, 5, 4, 1, 14, 16, 9, 18, 12, 11, 15, 13], [7, 0, 14, 9, 1, 6, 11, 10, 2, 17, 15, 5, 19, 8, 18, 12, 4, 13, 16, 3], [18, 15, 16, 10, 12, 6, 2, 1, 17, 5, 13, 4, 7, 8, 9, 19, 11, 3, 0, 14], [0, 6, 12, 4, 8, 1, 5, 17, 15, 2, 7, 9, 11, 13, 16, 3, 10, 18, 14, 19], [18, 9, 6, 4, 11, 19, 8, 10, 3, 0, 13, 15, 12, 2, 16, 5, 17, 7, 1, 14], [5, 10, 1, 14, 11, 18, 16, 7, 9, 13, 17, 15, 2, 12, 6, 3, 8, 4, 0, 19], [5, 6, 8, 3, 15, 19, 4, 2, 16, 14, 13, 10, 1, 7, 18, 9, 0, 11, 12, 17], [18, 8, 1, 14, 4, 6, 15, 10, 7, 13, 17, 5, 11, 16, 3, 12, 2, 0, 9, 19], [6, 13, 5, 8, 2, 18, 17, 19, 14, 10, 7, 15, 0, 9, 11, 4, 1, 3, 16, 12]]

# Decision variable: completion time of operation op for each job.
completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))


def precedence_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # Each job's operations must respect sequence order with processing times.
    for j in range(N_JOBS):
        assert completion[j][0] >= PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][0]]
        for op in range(1, N_MACHINES):
            assert completion[j][op] >= completion[j][op - 1] + PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][op]]


def no_overlap_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # No two jobs can use the same machine at overlapping times.
    for m in range(N_MACHINES):
        for j1 in range(N_JOBS):
            for op1 in range(N_MACHINES):
                if MACHINE_SEQUENCE[j1][op1] == m:
                    for j2 in range(j1 + 1, N_JOBS):
                        for op2 in range(N_MACHINES):
                            if MACHINE_SEQUENCE[j2][op2] == m:
                                assert (
                                    completion[j1][op1] >= completion[j2][op2] + PROCESSING_TIMES[j1][m]
                                    or completion[j2][op2] >= completion[j1][op1] + PROCESSING_TIMES[j2][m]
                                )


def makespan(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    ms: DSInt() = 0
    for j in range(N_JOBS):
        if completion[j][N_MACHINES - 1] > ms:
            ms = completion[j][N_MACHINES - 1]
    return ms


precedence_constraint(completion)
no_overlap_constraint(completion)

objective: DSInt(0, MAX_TIME) = makespan(completion)

minimize(objective)
