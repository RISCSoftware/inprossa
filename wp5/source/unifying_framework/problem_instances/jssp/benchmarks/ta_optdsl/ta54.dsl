MACHINE_SEQUENCE : DSList(N_JOBS, DSList(N_MACHINES, DSInt())) = [[11, 14, 9, 1, 5, 13, 6, 8, 10, 7, 4, 12, 0, 2, 3], [12, 11, 10, 4, 6, 14, 2, 0, 5, 3, 1, 13, 9, 8, 7], [4, 0, 13, 14, 7, 9, 12, 11, 10, 2, 6, 1, 5, 3, 8], [4, 12, 14, 3, 8, 9, 0, 6, 1, 7, 11, 13, 2, 10, 5], [10, 4, 5, 14, 9, 12, 6, 13, 0, 3, 8, 2, 11, 1, 7], [8, 0, 12, 1, 7, 4, 5, 3, 2, 14, 10, 9, 13, 6, 11], [9, 4, 13, 2, 14, 10, 12, 6, 1, 11, 5, 8, 7, 0, 3], [9, 4, 12, 11, 6, 7, 0, 2, 10, 3, 14, 13, 1, 8, 5], [8, 12, 3, 5, 7, 14, 1, 11, 10, 4, 0, 9, 6, 13, 2], [8, 11, 9, 13, 3, 12, 5, 7, 10, 2, 1, 14, 6, 4, 0], [4, 9, 2, 10, 12, 6, 8, 0, 13, 5, 11, 14, 7, 1, 3], [10, 6, 5, 4, 12, 3, 9, 13, 14, 8, 2, 7, 11, 1, 0], [5, 9, 0, 12, 8, 10, 13, 11, 3, 7, 14, 6, 1, 4, 2], [4, 5, 12, 2, 6, 14, 0, 7, 1, 11, 13, 10, 8, 9, 3], [14, 10, 8, 5, 4, 9, 7, 13, 3, 1, 2, 6, 11, 12, 0], [8, 12, 11, 7, 10, 2, 3, 6, 4, 1, 9, 5, 13, 14, 0], [1, 4, 5, 6, 9, 13, 3, 7, 2, 14, 11, 0, 10, 12, 8], [12, 8, 3, 10, 9, 1, 7, 6, 2, 4, 0, 13, 5, 14, 11], [5, 12, 1, 2, 3, 0, 7, 13, 6, 11, 4, 8, 10, 9, 14], [12, 1, 8, 11, 2, 7, 6, 10, 4, 13, 14, 9, 5, 3, 0], [3, 9, 8, 0, 11, 1, 14, 10, 4, 13, 5, 2, 12, 7, 6], [11, 1, 9, 4, 3, 8, 12, 0, 6, 7, 14, 10, 13, 2, 5], [1, 7, 6, 5, 9, 14, 2, 4, 3, 0, 13, 12, 11, 8, 10], [2, 14, 9, 13, 7, 8, 6, 5, 4, 0, 12, 11, 3, 1, 10], [9, 4, 12, 1, 6, 10, 8, 7, 2, 11, 13, 14, 3, 0, 5], [4, 1, 9, 0, 8, 2, 14, 3, 5, 6, 7, 13, 11, 12, 10], [7, 8, 6, 4, 13, 1, 5, 14, 2, 10, 12, 0, 3, 9, 11], [5, 12, 10, 9, 1, 4, 13, 11, 14, 2, 7, 0, 3, 8, 6], [1, 13, 0, 5, 4, 6, 8, 11, 14, 12, 9, 10, 7, 3, 2], [3, 6, 10, 5, 7, 8, 9, 0, 14, 1, 12, 2, 11, 13, 4], [4, 8, 6, 9, 3, 2, 0, 5, 13, 7, 1, 12, 10, 14, 11], [4, 0, 12, 6, 1, 3, 14, 11, 7, 2, 5, 8, 10, 13, 9], [7, 10, 1, 14, 6, 11, 8, 4, 12, 5, 0, 13, 2, 9, 3], [12, 13, 1, 10, 7, 2, 9, 14, 4, 11, 5, 3, 6, 0, 8], [0, 2, 10, 1, 12, 4, 5, 11, 9, 3, 8, 7, 6, 13, 14], [0, 10, 13, 12, 6, 1, 8, 2, 3, 14, 9, 4, 7, 5, 11], [12, 2, 10, 4, 9, 6, 0, 1, 7, 13, 11, 8, 3, 14, 5], [3, 1, 12, 5, 6, 2, 8, 14, 0, 11, 7, 10, 13, 9, 4], [11, 6, 14, 5, 4, 3, 1, 0, 7, 12, 2, 13, 8, 10, 9], [3, 2, 10, 9, 1, 5, 13, 8, 7, 4, 6, 0, 11, 12, 14], [6, 2, 9, 7, 13, 8, 1, 11, 12, 5, 10, 3, 14, 4, 0], [2, 4, 7, 14, 11, 8, 9, 13, 0, 1, 5, 12, 10, 3, 6], [10, 12, 7, 11, 0, 14, 2, 1, 4, 6, 13, 5, 8, 3, 9], [0, 9, 11, 1, 14, 4, 3, 7, 2, 5, 12, 10, 8, 13, 6], [10, 0, 12, 9, 5, 4, 7, 2, 8, 13, 1, 6, 11, 14, 3], [2, 8, 6, 5, 7, 11, 3, 14, 10, 1, 0, 4, 9, 13, 12], [2, 5, 3, 13, 0, 10, 12, 14, 6, 7, 1, 8, 9, 4, 11], [2, 5, 14, 1, 7, 13, 12, 10, 3, 6, 9, 8, 11, 4, 0], [12, 1, 8, 3, 10, 4, 5, 11, 6, 14, 7, 9, 2, 13, 0], [5, 2, 14, 10, 11, 3, 6, 1, 9, 8, 12, 7, 0, 13, 4]]

# Decision variable: completion time of operation op for each job.
completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))


def precedence_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # Each job's operations must respect sequence order with processing times.
    for j in range(N_JOBS):
        assert completion[j][0] >= PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][0]]
        for op in range(1, N_MACHINES):
            assert completion[j][op] >= completion[j][op - 1] + PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][op]]


def no_overlap_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # No two jobs can use the same machine at overlapping times.
    for m in range(N_MACHINES):
        for j1 in range(N_JOBS):
            for op1 in range(N_MACHINES):
                if MACHINE_SEQUENCE[j1][op1] == m:
                    for j2 in range(j1 + 1, N_JOBS):
                        for op2 in range(N_MACHINES):
                            if MACHINE_SEQUENCE[j2][op2] == m:
                                assert (
                                    completion[j1][op1] >= completion[j2][op2] + PROCESSING_TIMES[j1][m]
                                    or completion[j2][op2] >= completion[j1][op1] + PROCESSING_TIMES[j2][m]
                                )


def makespan(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    ms: DSInt() = 0
    for j in range(N_JOBS):
        if completion[j][N_MACHINES - 1] > ms:
            ms = completion[j][N_MACHINES - 1]
    return ms


precedence_constraint(completion)
no_overlap_constraint(completion)

objective: DSInt(0, MAX_TIME) = makespan(completion)

minimize(objective)
