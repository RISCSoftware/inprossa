MACHINE_SEQUENCE : DSList(N_JOBS, DSList(N_MACHINES, DSInt())) = [[4, 10, 12, 5, 3, 8, 19, 15, 6, 0, 11, 13, 1, 16, 17, 18, 2, 14, 7, 9], [6, 1, 2, 13, 11, 3, 12, 14, 10, 19, 7, 18, 16, 17, 15, 5, 0, 4, 9, 8], [17, 15, 8, 16, 1, 10, 13, 14, 6, 12, 0, 9, 5, 18, 2, 4, 3, 19, 11, 7], [7, 1, 2, 17, 16, 8, 9, 4, 15, 14, 6, 18, 13, 3, 0, 11, 19, 12, 5, 10], [10, 1, 7, 3, 17, 0, 2, 18, 12, 16, 6, 13, 11, 8, 15, 19, 9, 14, 5, 4], [4, 8, 3, 9, 12, 2, 6, 18, 5, 19, 1, 11, 17, 0, 13, 16, 14, 7, 15, 10], [17, 4, 13, 19, 15, 3, 2, 1, 7, 16, 8, 10, 12, 6, 11, 9, 14, 18, 5, 0], [10, 1, 0, 17, 18, 7, 16, 6, 15, 12, 2, 11, 4, 8, 14, 5, 19, 13, 3, 9], [17, 0, 9, 7, 4, 2, 5, 18, 11, 12, 14, 13, 19, 3, 8, 10, 1, 15, 6, 16], [11, 1, 9, 16, 12, 3, 6, 13, 10, 14, 8, 19, 4, 18, 0, 5, 17, 15, 2, 7], [19, 18, 14, 10, 13, 5, 3, 11, 8, 7, 16, 0, 6, 4, 2, 12, 9, 15, 17, 1], [5, 18, 6, 9, 17, 12, 3, 14, 15, 0, 19, 4, 2, 1, 10, 8, 16, 11, 13, 7], [2, 0, 5, 18, 19, 9, 7, 10, 11, 4, 8, 15, 17, 1, 14, 6, 12, 13, 16, 3], [10, 12, 4, 8, 13, 17, 2, 19, 15, 16, 3, 0, 6, 5, 1, 11, 18, 14, 7, 9], [1, 16, 19, 0, 17, 15, 2, 9, 3, 6, 10, 18, 7, 14, 13, 8, 12, 11, 4, 5], [2, 14, 9, 16, 3, 0, 4, 12, 13, 19, 17, 15, 8, 18, 11, 7, 6, 1, 5, 10], [17, 8, 19, 7, 4, 18, 12, 13, 3, 11, 6, 9, 1, 5, 10, 15, 0, 14, 2, 16], [13, 2, 6, 14, 18, 7, 8, 0, 16, 1, 3, 10, 19, 4, 12, 11, 5, 15, 17, 9], [15, 19, 11, 0, 4, 10, 7, 1, 8, 6, 9, 18, 14, 13, 3, 12, 2, 5, 16, 17], [17, 8, 4, 10, 12, 0, 11, 9, 7, 16, 18, 19, 1, 13, 3, 6, 2, 14, 15, 5], [8, 1, 11, 19, 16, 5, 17, 7, 2, 15, 12, 0, 9, 3, 13, 6, 4, 10, 14, 18], [16, 13, 0, 1, 10, 15, 14, 8, 17, 18, 19, 2, 4, 12, 7, 6, 9, 11, 3, 5], [7, 6, 4, 17, 15, 14, 19, 8, 10, 0, 3, 12, 16, 5, 13, 9, 18, 2, 1, 11], [9, 1, 4, 11, 17, 16, 12, 14, 6, 2, 15, 5, 10, 0, 8, 13, 18, 3, 7, 19], [12, 3, 14, 10, 0, 4, 11, 5, 15, 9, 2, 6, 8, 13, 18, 17, 1, 16, 7, 19], [13, 8, 4, 6, 3, 7, 19, 2, 5, 9, 18, 11, 10, 16, 0, 1, 14, 12, 17, 15], [10, 0, 1, 13, 12, 11, 5, 8, 19, 2, 3, 7, 4, 6, 17, 9, 15, 16, 14, 18], [16, 19, 13, 3, 15, 1, 8, 14, 12, 2, 5, 17, 0, 9, 11, 10, 18, 4, 6, 7], [11, 4, 8, 13, 5, 3, 18, 1, 17, 14, 12, 9, 6, 19, 10, 2, 0, 7, 15, 16], [16, 11, 14, 8, 19, 5, 17, 12, 3, 15, 13, 18, 9, 6, 1, 0, 7, 10, 4, 2]]

# Decision variable: completion time of operation op for each job.
completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))


def precedence_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # Each job's operations must respect sequence order with processing times.
    for j in range(N_JOBS):
        assert completion[j][0] >= PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][0]]
        for op in range(1, N_MACHINES):
            assert completion[j][op] >= completion[j][op - 1] + PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][op]]


def no_overlap_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # No two jobs can use the same machine at overlapping times.
    for m in range(N_MACHINES):
        for j1 in range(N_JOBS):
            for op1 in range(N_MACHINES):
                if MACHINE_SEQUENCE[j1][op1] == m:
                    for j2 in range(j1 + 1, N_JOBS):
                        for op2 in range(N_MACHINES):
                            if MACHINE_SEQUENCE[j2][op2] == m:
                                assert (
                                    completion[j1][op1] >= completion[j2][op2] + PROCESSING_TIMES[j1][m]
                                    or completion[j2][op2] >= completion[j1][op1] + PROCESSING_TIMES[j2][m]
                                )


def makespan(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    ms: DSInt() = 0
    for j in range(N_JOBS):
        if completion[j][N_MACHINES - 1] > ms:
            ms = completion[j][N_MACHINES - 1]
    return ms


precedence_constraint(completion)
no_overlap_constraint(completion)

objective: DSInt(0, MAX_TIME) = makespan(completion)

minimize(objective)
