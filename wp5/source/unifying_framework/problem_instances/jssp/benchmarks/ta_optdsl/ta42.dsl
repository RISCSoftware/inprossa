# Job Shop Scheduling instance: ta42
# Minimize makespan (total completion time for all jobs).

N_JOBS : int = 30
N_MACHINES : int = 20
MAX_TIME : int = 30591

# PROCESSING_TIMES[j][m] = time job j needs on machine m (MACHINE-indexed).
