MACHINE_SEQUENCE : DSList(N_JOBS, DSList(N_MACHINES, DSInt())) = [[11, 3, 12, 0, 14, 9, 1, 6, 2, 13, 7, 4, 5, 8, 10], [2, 8, 14, 1, 0, 10, 6, 12, 7, 9, 3, 4, 11, 13, 5], [13, 0, 5, 6, 14, 11, 4, 3, 7, 9, 12, 8, 2, 10, 1], [13, 4, 9, 11, 1, 6, 12, 2, 10, 3, 0, 7, 14, 8, 5], [9, 3, 4, 7, 11, 0, 8, 10, 6, 5, 14, 12, 1, 2, 13], [2, 0, 5, 3, 12, 1, 4, 6, 9, 7, 8, 10, 14, 13, 11], [6, 1, 9, 2, 7, 10, 4, 11, 0, 13, 14, 12, 3, 5, 8], [2, 13, 14, 4, 3, 10, 7, 9, 6, 5, 1, 11, 12, 0, 8], [7, 14, 12, 2, 13, 8, 6, 0, 1, 5, 11, 9, 4, 3, 10], [10, 5, 7, 3, 12, 6, 2, 0, 13, 8, 14, 9, 11, 4, 1], [13, 4, 14, 6, 3, 2, 5, 8, 9, 12, 7, 0, 11, 10, 1], [9, 14, 7, 6, 11, 12, 4, 5, 10, 13, 3, 1, 8, 0, 2], [8, 10, 7, 11, 13, 1, 2, 3, 14, 12, 9, 4, 5, 6, 0], [5, 10, 2, 4, 7, 9, 12, 3, 13, 1, 14, 6, 8, 0, 11], [13, 1, 11, 7, 3, 8, 5, 4, 2, 6, 0, 14, 9, 12, 10], [3, 4, 7, 9, 8, 5, 11, 14, 12, 2, 6, 10, 0, 13, 1], [10, 3, 9, 14, 0, 7, 13, 12, 6, 11, 4, 8, 1, 2, 5], [9, 12, 13, 14, 6, 2, 4, 7, 0, 8, 11, 3, 10, 5, 1], [7, 3, 6, 12, 13, 14, 0, 5, 8, 1, 11, 2, 10, 9, 4], [3, 11, 12, 4, 6, 0, 13, 8, 5, 9, 7, 1, 10, 14, 2], [4, 2, 1, 3, 13, 10, 12, 8, 14, 5, 7, 6, 11, 0, 9], [7, 8, 5, 3, 13, 0, 10, 12, 11, 6, 2, 1, 4, 9, 14], [8, 13, 14, 5, 12, 11, 10, 9, 2, 3, 7, 0, 6, 1, 4], [0, 9, 1, 8, 6, 12, 5, 7, 4, 3, 2, 13, 10, 14, 11], [8, 5, 7, 2, 6, 11, 13, 4, 9, 0, 1, 14, 12, 10, 3], [10, 11, 3, 8, 2, 7, 14, 4, 1, 5, 0, 6, 9, 13, 12], [11, 0, 5, 8, 9, 4, 1, 6, 2, 3, 14, 10, 13, 12, 7], [11, 0, 8, 2, 1, 6, 13, 9, 14, 12, 10, 4, 5, 3, 7], [2, 12, 7, 4, 13, 8, 0, 9, 5, 11, 1, 3, 10, 6, 14], [8, 3, 6, 1, 12, 7, 11, 4, 9, 2, 10, 14, 13, 5, 0], [2, 6, 7, 13, 8, 3, 1, 10, 14, 11, 9, 5, 12, 4, 0], [13, 5, 2, 12, 1, 6, 4, 0, 3, 8, 7, 9, 11, 10, 14], [0, 13, 4, 10, 14, 7, 8, 1, 3, 9, 6, 5, 11, 12, 2], [4, 13, 10, 5, 8, 2, 1, 3, 6, 14, 12, 7, 11, 9, 0], [9, 13, 3, 5, 12, 14, 6, 1, 4, 10, 2, 7, 8, 11, 0], [12, 6, 11, 4, 1, 9, 8, 5, 0, 13, 2, 14, 10, 3, 7], [3, 10, 4, 13, 9, 7, 14, 12, 11, 8, 2, 1, 0, 5, 6], [13, 12, 1, 2, 8, 0, 7, 4, 10, 6, 9, 5, 3, 11, 14], [13, 8, 2, 7, 11, 12, 10, 9, 6, 4, 1, 0, 3, 5, 14], [6, 11, 3, 4, 8, 2, 10, 13, 7, 5, 9, 1, 14, 0, 12], [8, 2, 7, 13, 9, 3, 14, 12, 0, 1, 10, 6, 5, 11, 4], [6, 4, 8, 9, 2, 5, 13, 1, 12, 11, 14, 0, 7, 10, 3], [13, 9, 12, 3, 14, 5, 8, 7, 10, 4, 11, 0, 1, 2, 6], [7, 3, 10, 1, 8, 5, 0, 11, 9, 13, 2, 4, 14, 6, 12], [11, 13, 8, 1, 12, 4, 2, 10, 6, 9, 3, 14, 0, 7, 5], [1, 11, 10, 7, 5, 3, 14, 2, 13, 6, 4, 9, 0, 12, 8], [14, 11, 1, 8, 5, 13, 0, 9, 4, 12, 6, 10, 3, 2, 7], [10, 5, 7, 2, 11, 4, 3, 14, 9, 0, 12, 6, 1, 13, 8], [14, 12, 10, 6, 4, 13, 8, 7, 2, 11, 5, 3, 1, 0, 9], [12, 2, 10, 3, 4, 0, 13, 14, 7, 5, 6, 8, 1, 11, 9]]

# Decision variable: completion time of operation op for each job.
completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))


def precedence_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # Each job's operations must respect sequence order with processing times.
    for j in range(N_JOBS):
        assert completion[j][0] >= PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][0]]
        for op in range(1, N_MACHINES):
            assert completion[j][op] >= completion[j][op - 1] + PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][op]]


def no_overlap_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # No two jobs can use the same machine at overlapping times.
    for m in range(N_MACHINES):
        for j1 in range(N_JOBS):
            for op1 in range(N_MACHINES):
                if MACHINE_SEQUENCE[j1][op1] == m:
                    for j2 in range(j1 + 1, N_JOBS):
                        for op2 in range(N_MACHINES):
                            if MACHINE_SEQUENCE[j2][op2] == m:
                                assert (
                                    completion[j1][op1] >= completion[j2][op2] + PROCESSING_TIMES[j1][m]
                                    or completion[j2][op2] >= completion[j1][op1] + PROCESSING_TIMES[j2][m]
                                )


def makespan(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    ms: DSInt() = 0
    for j in range(N_JOBS):
        if completion[j][N_MACHINES - 1] > ms:
            ms = completion[j][N_MACHINES - 1]
    return ms


precedence_constraint(completion)
no_overlap_constraint(completion)

objective: DSInt(0, MAX_TIME) = makespan(completion)

minimize(objective)
