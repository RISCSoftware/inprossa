, 14, 51, 32, 33, 18, 26, 53, 45, 32, 89, 7, 13, 17, 43, 31, 47, 62, 45], [63, 56, 76, 73, 34, 51, 30, 63, 87, 52, 40, 97, 68, 6, 3, 39, 49, 99, 95, 56], [30, 96, 50, 73, 71, 11, 6, 92, 20, 58, 62, 59, 68, 62, 31, 71, 67, 10, 23, 65], [79, 4, 78, 36, 62, 92, 21, 89, 52, 64, 41, 27, 78, 83, 25, 64, 80, 92, 98, 88], [37, 18, 10, 54, 23, 78, 37, 10, 8, 87, 14, 88, 27, 95, 49, 74, 15, 94, 40, 1], [21, 3, 83, 81, 92, 23, 73, 74, 46, 93, 51, 17, 53, 1, 76, 52, 9, 56, 69, 32]]
MACHINE_SEQUENCE : DSList(N_JOBS, DSList(N_MACHINES, DSInt())) = [[11, 18, 19, 9, 1, 10, 3, 13, 7, 5, 15, 0, 4, 6, 8, 17, 16, 2, 14, 12], [8, 15, 18, 16, 6, 0, 2, 11, 13, 7, 10, 19, 9, 12, 3, 17, 14, 4, 5, 1], [17, 18, 2, 4, 14, 7, 10, 12, 13, 0, 19, 15, 5, 16, 1, 11, 9, 6, 8, 3], [2, 17, 4, 10, 9, 6, 12, 8, 5, 18, 3, 7, 16, 11, 19, 14, 15, 13, 1, 0], [4, 11, 18, 9, 2, 12, 16, 5, 7, 6, 8, 15, 3, 13, 14, 10, 0, 1, 19, 17], [4, 6, 16, 18, 14, 2, 7, 9, 1, 15, 10, 12, 5, 8, 19, 13, 17, 3, 0, 11], [19, 14, 11, 3, 6, 9, 15, 4, 2, 12, 17, 10, 13, 8, 0, 16, 7, 1, 5, 18], [6, 9, 17, 12, 16, 5, 0, 8, 1, 3, 14, 13, 7, 2, 4, 15, 18, 11, 10, 19], [10, 16, 17, 5, 15, 18, 14, 2, 0, 1, 4, 13, 7, 12, 9, 6, 8, 3, 19, 11], [6, 11, 15, 17, 14, 9, 7, 10, 16, 19, 8, 1, 4, 13, 5, 0, 3, 12, 18, 2], [10, 11, 7, 14, 5, 2, 19, 15, 1, 12, 8, 0, 16, 13, 9, 4, 17, 3, 18, 6], [19, 9, 0, 3, 14, 7, 13, 6, 11, 8, 15, 10, 4, 12, 1, 2, 18, 17, 5, 16], [6, 16, 10, 13, 9, 18, 14, 4, 1, 8, 17, 5, 2, 12, 3, 19, 0, 7, 15, 11], [4, 11, 5, 0, 15, 12, 13, 19, 14, 3, 16, 10, 9, 1, 18, 6, 17, 8, 7, 2], [1, 12, 3, 15, 11, 2, 5, 8, 16, 9, 17, 7, 4, 13, 6, 14, 0, 10, 19, 18], [19, 12, 7, 14, 13, 10, 2, 11, 3, 0, 16, 17, 9, 1, 18, 15, 8, 5, 6, 4], [16, 19, 12, 9, 3, 5, 6, 17, 13, 4, 8, 7, 1, 10, 14, 0, 11, 15, 2, 18], [7, 6, 0, 19, 9, 3, 16, 8, 11, 4, 12, 2, 13, 17, 18, 15, 1, 14, 5, 10], [12, 9, 19, 14, 7, 8, 0, 13, 16, 11, 6, 3, 1, 2, 4, 5, 10, 15, 18, 17], [1, 4, 18, 11, 0, 16, 12, 8, 13, 7, 2, 19, 3, 5, 9, 15, 17, 14, 10, 6], [10, 16, 3, 5, 4, 7, 11, 19, 15, 14, 9, 8, 6, 18, 12, 0, 1, 2, 13, 17], [5, 4, 7, 8, 0, 11, 1, 3, 17, 14, 16, 19, 15, 13, 10, 6, 12, 2, 9, 18], [13, 14, 16, 5, 0, 7, 18, 12, 1, 3, 19, 17, 11, 4, 2, 9, 15, 8, 6, 10], [14, 16, 19, 15, 7, 11, 4, 9, 10, 3, 18, 6, 13, 17, 2, 0, 5, 12, 1, 8], [8, 13, 6, 5, 1, 19, 14, 17, 9, 0, 12, 11, 3, 4, 7, 10, 15, 18, 16, 2], [0, 19, 12, 16, 10, 5, 14, 8, 7, 9, 18, 1, 11, 6, 17, 15, 13, 2, 4, 3], [12, 14, 11, 6, 0, 9, 3, 13, 4, 1, 18, 15, 8, 5, 2, 7, 10, 16, 17, 19], [18, 13, 7, 15, 1, 11, 0, 14, 2, 3, 8, 10, 6, 4, 12, 17, 5, 19, 16, 9], [11, 5, 7, 10, 8, 1, 2, 6, 14, 12, 17, 13, 0, 4, 16, 9, 3, 19, 15, 18], [0, 1, 19, 10, 16, 14, 5, 6, 12, 3, 7, 4, 18, 17, 9, 15, 2, 13, 11, 8]]

# Decision variable: completion time of operation op for each job.
completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))


def precedence_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # Each job's operations must respect sequence order with processing times.
    for j in range(N_JOBS):
        assert completion[j][0] >= PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][0]]
        for op in range(1, N_MACHINES):
            assert completion[j][op] >= completion[j][op - 1] + PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][op]]


def no_overlap_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # No two jobs can use the same machine at overlapping times.
    for m in range(N_MACHINES):
        for j1 in range(N_JOBS):
            for op1 in range(N_MACHINES):
                if MACHINE_SEQUENCE[j1][op1] == m:
                    for j2 in range(j1 + 1, N_JOBS):
                        for op2 in range(N_MACHINES):
                            if MACHINE_SEQUENCE[j2][op2] == m:
                                assert (
                                    completion[j1][op1] >= completion[j2][op2] + PROCESSING_TIMES[j1][m]
                                    or completion[j2][op2] >= completion[j1][op1] + PROCESSING_TIMES[j2][m]
                                )


def makespan(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    ms: DSInt() = 0
    for j in range(N_JOBS):
        if completion[j][N_MACHINES - 1] > ms:
            ms = completion[j][N_MACHINES - 1]
    return ms


precedence_constraint(completion)
no_overlap_constraint(completion)

objective: DSInt(0, MAX_TIME) = makespan(completion)

minimize(objective)
