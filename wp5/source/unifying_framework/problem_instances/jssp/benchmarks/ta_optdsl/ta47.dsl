], [15, 39, 93, 86, 75, 63, 49, 81, 92, 76, 97, 87, 13, 85, 57, 73, 35, 53, 95, 70], [63, 76, 24, 94, 71, 86, 49, 72, 35, 42, 44, 73, 16, 92, 6, 31, 46, 54, 34, 97], [72, 23, 4, 10, 47, 72, 88, 89, 88, 77, 36, 24, 75, 76, 63, 76, 30, 4, 83, 75], [57, 7, 15, 68, 80, 3, 12, 34, 33, 99, 94, 72, 24, 65, 1, 36, 44, 68, 77, 6], [63, 91, 5, 72, 92, 70, 90, 47, 98, 54, 83, 11, 18, 57, 42, 54, 96, 60, 3, 32], [11, 71, 4, 68, 18, 52, 99, 47, 68, 20, 77, 33, 88, 16, 4, 82, 29, 66, 29, 57]]
MACHINE_SEQUENCE : DSList(N_JOBS, DSList(N_MACHINES, DSInt())) = [[11, 19, 16, 7, 12, 1, 10, 8, 6, 18, 2, 13, 17, 14, 0, 3, 15, 4, 5, 9], [4, 19, 8, 17, 0, 5, 1, 6, 11, 12, 10, 13, 2, 3, 15, 18, 16, 7, 14, 9], [19, 10, 14, 11, 3, 2, 13, 1, 0, 12, 9, 18, 4, 5, 16, 17, 7, 6, 8, 15], [2, 15, 6, 19, 17, 14, 12, 13, 1, 11, 5, 4, 9, 16, 18, 10, 8, 7, 0, 3], [17, 8, 10, 16, 19, 4, 2, 6, 0, 3, 9, 12, 11, 7, 1, 15, 14, 13, 18, 5], [5, 6, 13, 10, 19, 16, 9, 8, 15, 12, 4, 7, 14, 11, 17, 3, 18, 2, 0, 1], [2, 19, 4, 8, 9, 6, 7, 5, 11, 1, 13, 14, 17, 18, 10, 3, 12, 16, 0, 15], [16, 7, 1, 6, 5, 12, 4, 10, 14, 15, 8, 18, 0, 3, 9, 11, 17, 13, 19, 2], [12, 0, 2, 4, 1, 6, 14, 16, 19, 3, 17, 5, 11, 8, 9, 10, 13, 15, 7, 18], [6, 17, 13, 19, 16, 18, 11, 10, 3, 2, 14, 8, 5, 7, 15, 9, 12, 4, 0, 1], [12, 18, 11, 7, 17, 10, 6, 9, 3, 19, 14, 1, 4, 15, 0, 2, 13, 5, 8, 16], [0, 18, 11, 3, 15, 10, 5, 4, 7, 13, 8, 19, 17, 2, 14, 1, 6, 16, 9, 12], [3, 4, 7, 6, 5, 15, 8, 13, 17, 12, 9, 10, 18, 2, 14, 0, 11, 1, 19, 16], [5, 12, 14, 6, 3, 10, 13, 7, 8, 17, 15, 18, 4, 0, 1, 16, 9, 11, 2, 19], [7, 4, 10, 13, 11, 16, 18, 12, 8, 15, 19, 1, 0, 17, 2, 3, 9, 14, 6, 5], [0, 17, 4, 15, 11, 3, 14, 13, 10, 7, 8, 1, 9, 16, 5, 18, 12, 6, 19, 2], [19, 1, 11, 17, 5, 18, 7, 10, 12, 2, 0, 3, 4, 13, 6, 8, 16, 9, 15, 14], [3, 12, 1, 15, 7, 6, 8, 9, 13, 16, 19, 10, 4, 17, 5, 18, 14, 2, 0, 11], [11, 10, 15, 12, 7, 19, 9, 4, 8, 2, 1, 5, 6, 3, 17, 13, 0, 16, 18, 14], [0, 13, 9, 5, 15, 14, 17, 6, 11, 7, 12, 2, 10, 16, 1, 19, 4, 8, 18, 3], [14, 2, 13, 16, 9, 19, 7, 6, 18, 15, 4, 17, 0, 12, 5, 3, 11, 8, 10, 1], [16, 9, 17, 8, 6, 4, 19, 18, 7, 2, 14, 15, 12, 5, 10, 13, 3, 0, 11, 1], [5, 19, 2, 16, 10, 6, 13, 4, 11, 1, 3, 17, 9, 8, 15, 7, 18, 12, 14, 0], [4, 0, 10, 2, 1, 8, 18, 5, 13, 7, 19, 14, 6, 15, 17, 16, 12, 11, 9, 3], [6, 5, 10, 11, 3, 7, 0, 8, 15, 9, 17, 4, 2, 19, 16, 12, 13, 18, 1, 14], [18, 9, 0, 11, 14, 4, 1, 5, 19, 12, 17, 10, 6, 3, 13, 2, 15, 7, 8, 16], [17, 0, 16, 4, 18, 1, 8, 5, 15, 2, 3, 7, 19, 12, 11, 14, 13, 9, 10, 6], [4, 17, 13, 2, 15, 7, 10, 1, 9, 16, 11, 6, 8, 18, 12, 0, 3, 14, 5, 19], [6, 18, 5, 2, 3, 17, 19, 1, 14, 9, 12, 0, 15, 10, 4, 13, 16, 11, 8, 7], [10, 11, 17, 3, 6, 7, 5, 12, 14, 1, 9, 18, 15, 0, 13, 19, 2, 4, 16, 8]]

# Decision variable: completion time of operation op for each job.
completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))


def precedence_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # Each job's operations must respect sequence order with processing times.
    for j in range(N_JOBS):
        assert completion[j][0] >= PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][0]]
        for op in range(1, N_MACHINES):
            assert completion[j][op] >= completion[j][op - 1] + PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][op]]


def no_overlap_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # No two jobs can use the same machine at overlapping times.
    for m in range(N_MACHINES):
        for j1 in range(N_JOBS):
            for op1 in range(N_MACHINES):
                if MACHINE_SEQUENCE[j1][op1] == m:
                    for j2 in range(j1 + 1, N_JOBS):
                        for op2 in range(N_MACHINES):
                            if MACHINE_SEQUENCE[j2][op2] == m:
                                assert (
                                    completion[j1][op1] >= completion[j2][op2] + PROCESSING_TIMES[j1][m]
                                    or completion[j2][op2] >= completion[j1][op1] + PROCESSING_TIMES[j2][m]
                                )


def makespan(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    ms: DSInt() = 0
    for j in range(N_JOBS):
        if completion[j][N_MACHINES - 1] > ms:
            ms = completion[j][N_MACHINES - 1]
    return ms


precedence_constraint(completion)
no_overlap_constraint(completion)

objective: DSInt(0, MAX_TIME) = makespan(completion)

minimize(objective)
