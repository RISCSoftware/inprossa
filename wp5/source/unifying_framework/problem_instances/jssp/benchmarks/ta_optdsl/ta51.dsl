MACHINE_SEQUENCE : DSList(N_JOBS, DSList(N_MACHINES, DSInt())) = [[9, 10, 3, 8, 5, 7, 4, 0, 12, 1, 13, 6, 11, 2, 14], [1, 7, 8, 2, 9, 14, 12, 4, 3, 11, 13, 0, 5, 10, 6], [2, 13, 11, 4, 14, 8, 10, 3, 6, 5, 7, 1, 9, 12, 0], [10, 12, 7, 1, 5, 14, 4, 9, 2, 3, 8, 0, 11, 13, 6], [5, 3, 7, 0, 9, 6, 11, 10, 12, 4, 14, 2, 1, 8, 13], [3, 0, 6, 2, 4, 1, 5, 14, 10, 13, 11, 9, 7, 8, 12], [13, 10, 9, 8, 1, 6, 14, 0, 12, 11, 7, 2, 3, 5, 4], [14, 11, 10, 13, 12, 6, 4, 0, 7, 5, 2, 1, 3, 8, 9], [7, 2, 8, 10, 1, 14, 5, 4, 0, 12, 3, 9, 6, 13, 11], [12, 5, 4, 7, 3, 1, 11, 8, 14, 6, 9, 2, 10, 0, 13], [9, 11, 8, 5, 4, 6, 2, 12, 14, 1, 10, 7, 0, 3, 13], [3, 9, 7, 5, 4, 10, 2, 8, 14, 11, 12, 6, 13, 0, 1], [8, 4, 12, 3, 2, 9, 10, 6, 0, 13, 14, 1, 5, 7, 11], [14, 3, 8, 11, 5, 7, 12, 10, 2, 0, 13, 6, 1, 9, 4], [1, 4, 14, 3, 10, 6, 5, 2, 11, 0, 8, 7, 9, 13, 12], [4, 8, 11, 2, 13, 0, 7, 12, 6, 3, 9, 1, 5, 10, 14], [10, 12, 1, 4, 8, 7, 14, 9, 2, 0, 13, 6, 11, 5, 3], [13, 11, 9, 12, 0, 1, 10, 4, 6, 14, 7, 8, 3, 2, 5], [10, 2, 14, 1, 7, 13, 4, 9, 5, 3, 8, 0, 11, 6, 12], [0, 11, 2, 10, 6, 3, 4, 5, 12, 8, 7, 14, 9, 1, 13], [1, 4, 8, 2, 3, 7, 12, 13, 9, 14, 0, 5, 11, 6, 10], [7, 12, 9, 5, 1, 2, 14, 10, 6, 4, 8, 3, 0, 13, 11], [2, 0, 10, 7, 3, 14, 11, 1, 5, 12, 8, 6, 4, 9, 13], [9, 4, 14, 1, 3, 2, 8, 0, 6, 10, 7, 5, 11, 12, 13], [0, 8, 2, 10, 13, 3, 12, 1, 7, 4, 9, 5, 6, 14, 11], [13, 14, 7, 6, 11, 12, 0, 1, 10, 8, 4, 3, 9, 5, 2], [7, 11, 0, 6, 2, 8, 14, 5, 4, 12, 13, 1, 9, 3, 10], [9, 7, 6, 5, 10, 1, 14, 11, 12, 0, 4, 3, 8, 2, 13], [2, 3, 8, 1, 12, 13, 7, 11, 5, 0, 9, 10, 4, 14, 6], [8, 4, 12, 11, 3, 7, 0, 10, 6, 1, 14, 2, 5, 9, 13], [8, 1, 4, 6, 7, 14, 3, 10, 5, 12, 0, 13, 11, 9, 2], [7, 13, 0, 8, 9, 1, 10, 12, 5, 3, 4, 11, 2, 6, 14], [10, 8, 14, 2, 12, 0, 3, 5, 1, 9, 11, 7, 13, 4, 6], [1, 2, 5, 9, 7, 4, 0, 3, 14, 12, 13, 10, 6, 11, 8], [11, 2, 4, 14, 6, 5, 7, 12, 9, 3, 8, 0, 10, 13, 1], [14, 8, 5, 7, 10, 13, 1, 0, 9, 4, 3, 2, 6, 12, 11], [13, 7, 12, 11, 8, 3, 9, 2, 1, 5, 14, 6, 0, 10, 4], [0, 14, 5,