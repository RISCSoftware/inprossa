8, 25, 30, 2, 70, 21, 25, 1, 5, 80, 13, 25, 44, 62, 63, 47, 7, 55, 56], [7, 71, 66, 36, 57, 80, 71, 94, 12, 99, 54, 46, 30, 41, 93, 38, 19, 12, 68, 6], [32, 14, 47, 54, 64, 58, 65, 50, 50, 19, 49, 46, 97, 54, 40, 15, 57, 61, 55, 70], [32, 76, 67, 34, 24, 83, 17, 53, 70, 46, 63, 67, 22, 94, 63, 14, 85, 46, 2, 84], [60, 50, 49, 11, 86, 5, 38, 20, 13, 87, 59, 86, 8, 16, 32, 63, 83, 25, 27, 42], [72, 20, 92, 50, 80, 21, 13, 64, 25, 18, 42, 48, 4, 93, 60, 83, 31, 14, 33, 74]]
MACHINE_SEQUENCE : DSList(N_JOBS, DSList(N_MACHINES, DSInt())) = [[8, 10, 5, 13, 11, 17, 19, 18, 9, 15, 3, 16, 0, 12, 7, 2, 1, 14, 6, 4], [14, 18, 1, 2, 13, 9, 16, 6, 19, 17, 7, 8, 3, 10, 0, 11, 15, 5, 12, 4], [9, 6, 13, 10, 5, 15, 2, 8, 19, 1, 4, 18, 11, 7, 16, 12, 0, 3, 14, 17], [14, 3, 10, 16, 18, 1, 17, 0, 6, 8, 2, 11, 19, 5, 7, 15, 12, 9, 4, 13], [5, 16, 11, 9, 17, 10, 18, 15, 0, 19, 6, 4, 13, 2, 1, 14, 3, 12, 7, 8], [7, 9, 1, 2, 4, 6, 10, 18, 17, 8, 5, 0, 19, 15, 14, 13, 11, 12, 3, 16], [0, 12, 1, 14, 18, 6, 8, 17, 10, 2, 19, 5, 16, 11, 7, 13, 9, 3, 15, 4], [16, 14, 18, 11, 1, 10, 5, 9, 7, 2, 12, 15, 17, 8, 0, 4, 19, 3, 6, 13], [10, 19, 18, 15, 8, 0, 2, 9, 13, 3, 6, 7, 12, 11, 1, 4, 5, 16, 14, 17], [9, 14, 10, 19, 8, 12, 7, 6, 18, 2, 11, 0, 13, 15, 16, 1, 17, 4, 3, 5], [3, 4, 18, 15, 6, 2, 16, 7, 5, 12, 9, 17, 0, 8, 1, 10, 14, 11, 19, 13], [2, 4, 1, 15, 16, 3, 17, 6, 11, 12, 7, 18, 8, 13, 0, 14, 19, 10, 9, 5], [16, 19, 10, 9, 14, 12, 18, 2, 17, 15, 6, 7, 5, 11, 1, 0, 4, 3, 8, 13], [12, 3, 17, 4, 8, 9, 2, 11, 13, 5, 18, 10, 6, 7, 1, 15, 16, 14, 0, 19], [7, 0, 18, 19, 15, 2, 9, 1, 10, 6, 3, 11, 13, 12, 8, 4, 16, 17, 5, 14], [1, 19, 14, 7, 17, 0, 13, 11, 16, 12, 10, 9, 6, 3, 18, 8, 15, 5, 4, 2], [10, 17, 9, 16, 18, 4, 2, 11, 5, 15, 8, 3, 7, 0, 12, 6, 14, 19, 13, 1], [12, 11, 7, 9, 19, 16, 17, 6, 15, 13, 10, 4, 1, 8, 5, 0, 2, 3, 14, 18], [15, 17, 10, 4, 14, 1, 3, 18, 8, 16, 6, 2, 0, 7, 11, 12, 5, 13, 19, 9], [0, 11, 17, 10, 15, 5, 12, 9, 6, 3, 4, 1, 7, 14, 16, 2, 8, 13, 18, 19], [13, 6, 4, 8, 18, 12, 0, 5, 3, 9, 1, 14, 11, 16, 2, 15, 7, 19, 17, 10], [8, 6, 14, 12, 0, 9, 10, 2, 18, 19, 13, 5, 17, 1, 11, 7, 4, 15, 3, 16], [12, 16, 8, 4, 19, 9, 13, 6, 3, 2, 10, 5, 14, 11, 15, 1, 17, 18, 0, 7], [10, 18, 8, 15, 6, 7, 2, 0, 11, 5, 17, 12, 14, 9, 13, 3, 4, 1, 19, 16], [6, 16, 4, 15, 0, 12, 7, 10, 5, 13, 17, 3, 14, 18, 1, 19, 8, 2, 9, 11], [13, 19, 0, 5, 14, 8, 10, 17, 15, 12, 18, 3, 16, 11, 6, 1, 7, 2, 9, 4], [16, 18, 11, 15, 17, 4, 9, 1, 10, 5, 13, 3, 8, 0, 14, 2, 19, 12, 7, 6], [7, 0, 18, 16, 6, 13, 17, 5, 14, 11, 9, 19, 3, 12, 4, 8, 10, 15, 1, 2], [17, 16, 9, 1, 0, 15, 11, 5, 3, 18, 12, 14, 13, 2, 7, 19, 10, 8, 4, 6], [7, 1, 16, 17, 3, 13, 0, 19, 6, 10, 9, 8, 15, 18, 5, 2, 11, 14, 12, 4]]

# Decision variable: completion time of operation op for each job.
completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))


def precedence_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # Each job's operations must respect sequence order with processing times.
    for j in range(N_JOBS):
        assert completion[j][0] >= PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][0]]
        for op in range(1, N_MACHINES):
            assert completion[j][op] >= completion[j][op - 1] + PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][op]]


def no_overlap_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # No two jobs can use the same machine at overlapping times.
    for m in range(N_MACHINES):
        for j1 in range(N_JOBS):
            for op1 in range(N_MACHINES):
                if MACHINE_SEQUENCE[j1][op1] == m:
                    for j2 in range(j1 + 1, N_JOBS):
                        for op2 in range(N_MACHINES):
                            if MACHINE_SEQUENCE[j2][op2] == m:
                                assert (
                                    completion[j1][op1] >= completion[j2][op2] + PROCESSING_TIMES[j1][m]
                                    or completion[j2][op2] >= completion[j1][op1] + PROCESSING_TIMES[j2][m]
                                )


def makespan(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    ms: DSInt() = 0
    for j in range(N_JOBS):
        if completion[j][N_MACHINES - 1] > ms:
            ms = completion[j][N_MACHINES - 1]
    return ms


precedence_constraint(completion)
no_overlap_constraint(completion)

objective: DSInt(0, MAX_TIME) = makespan(completion)

minimize(objective)
