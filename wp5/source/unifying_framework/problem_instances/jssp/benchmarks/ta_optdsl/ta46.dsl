MACHINE_SEQUENCE : DSList(N_JOBS, DSList(N_MACHINES, DSInt())) = [[19, 12, 14, 10, 15, 7, 11, 17, 1, 5, 8, 0, 18, 2, 3, 4, 9, 13, 6, 16], [10, 5, 11, 8, 16, 6, 19, 15, 0, 13, 1, 17, 3, 7, 18, 4, 2, 14, 9, 12], [15, 19, 10, 5, 6, 7, 3, 9, 1, 16, 17, 11, 14, 12, 4, 18, 2, 8, 13, 0], [13, 9, 14, 18, 1, 11, 19, 2, 3, 4, 10, 5, 12, 17, 6, 8, 16, 0, 15, 7], [3, 2, 10, 8, 1, 4, 5, 15, 12, 11, 13, 7, 0, 16, 17, 9, 6, 19, 14, 18], [19, 11, 6, 9, 7, 18, 13, 14, 15, 0, 16, 8, 12, 3, 10, 1, 5, 17, 2, 4], [15, 10, 5, 9, 19, 0, 8, 18, 12, 13, 6, 4, 17, 14, 7, 2, 1, 16, 3, 11], [19, 5, 14, 3, 4, 12, 15, 13, 6, 18, 7, 9, 11, 1, 16, 10, 17, 0, 2, 8], [12, 5, 19, 10, 8, 11, 0, 17, 4, 6, 13, 9, 16, 3, 2, 14, 7, 15, 1, 18], [9, 15, 12, 5, 3, 13, 19, 8, 16, 4, 18, 17, 7, 2, 6, 0, 10, 1, 14, 11], [1, 19, 18, 10, 6, 2, 15, 14, 7, 17, 11, 13, 5, 12, 16, 4, 0, 9, 3, 8], [11, 19, 2, 17, 14, 7, 15, 4, 5, 0, 1, 8, 3, 10, 13, 16, 12, 6, 9, 18], [6, 5, 3, 11, 13, 14, 9, 12, 8, 0, 19, 1, 2, 18, 4, 7, 15, 17, 10, 16], [2, 6, 4, 12, 17, 16, 0, 10, 7, 3, 5, 18, 1, 8, 9, 19, 15, 11, 14, 13], [9, 5, 1, 7, 11, 0, 8, 12, 2, 19, 10, 6, 4, 15, 13, 18, 14, 16, 3, 17], [14, 11, 5, 10, 4, 3, 1, 13, 7, 15, 2, 17, 0, 19, 18, 8, 9, 6, 16, 12], [2, 12, 5, 13, 17, 4, 14, 7, 6, 11, 19, 0, 16, 10, 15, 3, 9, 18, 1, 8], [5, 4, 2, 15, 10, 3, 14, 7, 19, 0, 11, 17, 8, 12, 16, 9, 1, 13, 6, 18], [4, 9, 13, 5, 8, 6, 7, 17, 0, 12, 1, 3, 16, 15, 19, 10, 2, 11, 18, 14], [14, 3, 16, 10, 6, 2, 5, 0, 13, 12, 9, 7, 8, 19, 18, 1, 17, 15, 11, 4], [17, 13, 16, 15, 5, 4, 3, 11, 0, 7, 10, 2, 12, 14, 1, 8, 19, 18, 9, 6], [2, 9, 17, 4, 7, 5, 0, 18, 19, 13, 11, 1, 8, 15, 16, 12, 10, 6, 14, 3], [12, 4, 18, 1, 19, 5, 14, 8, 0, 10, 15, 6, 17, 2, 11, 16, 3, 13, 9, 7], [13, 6, 11, 5, 17, 16, 19, 10, 0, 4, 3, 1, 9, 18, 2, 14, 7, 8, 15, 12], [14, 9, 13, 11, 2, 5, 6, 17, 8, 4, 12, 0, 15, 1, 18, 19, 3, 7, 16, 10], [9, 18, 6, 8, 1, 4, 16, 7, 12, 10, 13, 17, 5, 2, 0, 11, 19, 15, 14, 3], [2, 19, 15, 8, 14, 3, 4, 1, 6, 11, 17, 12, 13, 5, 9, 16, 18, 7, 10, 0], [19, 1, 17, 6, 13, 2, 12, 8, 0, 9, 11, 3, 10, 4, 15, 7, 16, 18, 5, 14], [17, 14, 6, 5, 18, 16, 13, 0, 19, 9, 2, 7, 10, 8, 4, 1, 12, 15, 3, 11], [19, 7, 8, 0, 4, 3, 18, 9, 5, 2, 12, 11, 13, 17, 15, 6, 14, 10, 1, 16]]

# Decision variable: completion time of operation op for each job.
completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))


def precedence_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # Each job's operations must respect sequence order with processing times.
    for j in range(N_JOBS):
        assert completion[j][0] >= PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][0]]
        for op in range(1, N_MACHINES):
            assert completion[j][op] >= completion[j][op - 1] + PROCESSING_TIMES[j][MACHINE_SEQUENCE[j][op]]


def no_overlap_constraint(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    # No two jobs can use the same machine at overlapping times.
    for m in range(N_MACHINES):
        for j1 in range(N_JOBS):
            for op1 in range(N_MACHINES):
                if MACHINE_SEQUENCE[j1][op1] == m:
                    for j2 in range(j1 + 1, N_JOBS):
                        for op2 in range(N_MACHINES):
                            if MACHINE_SEQUENCE[j2][op2] == m:
                                assert (
                                    completion[j1][op1] >= completion[j2][op2] + PROCESSING_TIMES[j1][m]
                                    or completion[j2][op2] >= completion[j1][op1] + PROCESSING_TIMES[j2][m]
                                )


def makespan(completion: DSList(N_JOBS, DSList(N_MACHINES, DSInt(0, MAX_TIME)))):
    ms: DSInt() = 0
    for j in range(N_JOBS):
        if completion[j][N_MACHINES - 1] > ms:
            ms = completion[j][N_MACHINES - 1]
    return ms


precedence_constraint(completion)
no_overlap_constraint(completion)

objective: DSInt(0, MAX_TIME) = makespan(completion)

minimize(objective)
